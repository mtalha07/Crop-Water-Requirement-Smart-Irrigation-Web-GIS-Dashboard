# Optional environment variables; no secrets are needed for the local demo.
# This file documents settings. Django does not automatically load .env files.
# Set these through your shell or hosting environment if you need overrides.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required if DJANGO_DEBUG=false. Supply your own value; do not commit it.
DJANGO_SECRET_KEY=

